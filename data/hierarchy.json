
{
  "metadata": {
    "module": "legislature",
    "title": "Legislative Hierarchy Configuration",
    "version": "1.0",
    "description": "Controls the visual organization and presentation of legislative institutions and posts.",
    "last_updated": "2026-11-11"
  },

  "display_settings": {
    "default_view": "hierarchy",
    "default_expanded": true,
    "show_descriptions": true,
    "show_category_labels": true,
    "allow_group_collapse": true,
    "allow_post_details": true
  },

  "sections": [

    {
      "id": "overview",
      "title": "Legislative Overview",
      "description": "Overall constitutional structure of the Indian Legislature.",
      "order": 1,
      "default_visible": true,

      "groups": [

        {
          "id": "legislative_framework",
          "title": "Constitutional Framework",
          "order": 1,
          "layout": "single",

          "items": [
            {
              "type": "institution",
              "institution_id": "indian_legislature",
              "display_style": "primary"
            }
          ]
        },

        {
          "id": "national_and_state",
          "title": "Legislative Institutions",
          "order": 2,
          "layout": "columns",

          "items": [
            {
              "type": "institution",
              "institution_id": "union_legislature",
              "display_style": "standard"
            },
            {
              "type": "institution",
              "institution_id": "state_legislature",
              "display_style": "standard"
            }
          ]
        },

        {
          "id": "union_houses",
          "title": "Parliamentary Houses",
          "order": 3,
          "layout": "columns",

          "items": [
            {
              "type": "institution",
              "institution_id": "lok_sabha",
              "display_style": "standard"
            },
            {
              "type": "institution",
              "institution_id": "rajya_sabha",
              "display_style": "standard"
            }
          ]
        },

        {
          "id": "state_houses",
          "title": "State Legislative Houses",
          "order": 4,
          "layout": "columns",

          "items": [
            {
              "type": "institution",
              "institution_id": "state_assembly",
              "display_style": "standard"
            },
            {
              "type": "institution",
              "institution_id": "state_council",
              "display_style": "conditional",
              "condition": {
                "field": "availability",
                "value": "selected_states"
              }
            }
          ]
        }

      ]
    },


